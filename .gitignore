# Python
__pycache__/
*.py[cod]
*.so

# Environments
.venv/
venv/
env/
.env
.envrc

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Jupyter / IDE
.ipynb_checkpoints/
.vscode/
.idea/

# Build artifacts
build/
dist/
*.egg-info/

# Local datasets and generated experiment artifacts
data/raw/*
data/interim/*
data/processed/*
outputs/*
models/*

# Preserve repository placeholders
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!outputs/.gitkeep
!models/.gitkeep

# ML binaries / arrays
*.keras
*.h5
*.npz
*.npy
